# Copy to .env and fill in. Generate keys with:  python -m app.cli gen-keys
ENV=dev
DATABASE_URL=postgresql+psycopg://stelnexus:stelnexus@127.0.0.1:5432/stelnexus
SECRET_KEY=
PII_KEY=
COOKIE_SECURE=true
# Production requires: ENV=prod, explicit TRUSTED_HOSTS, COOKIE_SAMESITE=lax|strict,
# explicit FRAME_ANCESTORS, DEBUG=false.

# JSON lists. Behind Caddy/nginx on the same box:
#TRUSTED_HOSTS=["stelnexus.example.com"]
#TRUSTED_PROXIES=["127.0.0.1"]

# --- several web workers / Cloudflare (docs/SCALING.md) ---
# Needed when uvicorn runs with --workers > 1: shared rate limits, instant chat across workers, cache clears.
#REDIS_URL=redis://127.0.0.1:6379/0
#REDIS_PREFIX=stelnexus
# Per worker. Total = (pool + overflow) x workers must stay under PostgreSQL's max_connections (or use PgBouncer).
#DB_POOL_SIZE=10
#DB_MAX_OVERFLOW=20
# DATABASE_URL goes through PgBouncer (transaction pooling, usually port 6432): turn off prepared statements.
#DB_PGBOUNCER=true
# Site is proxied by Cloudflare and Caddy imports deploy/cloudflare.caddy.
#TRUST_CLOUDFLARE=true
